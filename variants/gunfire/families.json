  "material_table": {
    "_about": "PROPOSED default material of every unit type and every kind of scenery (feeds decision damage-looks, which is about to ask for a material on everything). The material decides the impact look here and the hit, wear and end looks there. Strong simplifications are marked.",
    "units": {
      "light_fighter": "metal",
      "heavy_fighter": "metal",
      "bomber": "metal",
      "tank": "metal",
      "mobile_aa": "metal",
      "anti_aircraft_battery": "ground",
      "radio_tower": "metal",
      "military_complex": "stone",
      "bridge": "stone",
      "cruiser": "metal",
      "patrol_boat": "metal",
      "supply_boat": "wood"
    },
    "scenery": {
      "ground (dry land, roads, fields)": "ground",
      "sandbags and earthworks": "ground",
      "water, every depth (sea, river, shallows)": "water",
      "houses": "wood",
      "walls": "stone",
      "the bridge (deck, piers, wing walls)": "stone",
      "rubble and ruins": "stone",
      "rock and cliff steps": "stone",
      "trees": "wood",
      "wrecks (a downed plane, a burnt-out tank)": "metal"
    },
    "notes": [
