      "size_mult": 1.0,
      "look": "ground",
      "note": "dry land, roads, fields, sandbags and earthworks: dust and a small scorch"
    },
    "water": {
      "size_mult": 1.35,
      "look": "water",
      "note": "any depth: a splash, rings on the water, NO smoke"
    },
